node_modules/
dist/
.shadow/
*.db
*.db-journal
.env
.DS_Store
# macOS AppleDouble sidecars — `.DS_Store` alone does not match `._.DS_Store`.
._*
.pi/proposal-queue.json
.pi/flows/agents/
.pi/flows/results/
.pi/dashboard/kb/
# Stale TS compile output inside src/ directories.
# Plugins ship .tsx directly via package.json exports; .js/.d.ts artifacts
# from accidental tsc runs pollute the source tree and shadow real .tsx in
# resolvers. See change: add-ui-popover-primitive.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
# Hand-authored Vite ambient types (?worker / ?url) — not a build artifact.
!packages/client/src/vite-env.d.ts
# Hand-authored ambient module decl for the deep raw-TS import of @latentminds/pi-quotas — not a build artifact.
!packages/quota-plugin/src/pi-quotas.d.ts
packages/electron/resources/server
packages/electron/resources/node
packages/electron/resources/git
packages/electron/resources/icons
packages/electron/resources/offline-packages
packages/electron/resources/bundled-extensions
packages/electron/out
packages/electron/.vite
site/.astro/
*.tsbuildinfo
.worktrees/
# Per-worktree test-harness state (ports + compose project). See change: parallelize-test-harness.
.pi-test-harness.json
# Playwright E2E outputs (tests/e2e). See change: add-playwright-e2e.
playwright-report/
# Sharded blob reports (CI=1). See change: stabilize-browser-e2e (task 1.3).
blob-report/
# Electron-E2E outputs. See change: electron-attach-ownership-fixes.
playwright-report-electron/
test-results/
.playwright/
doc-example/

# kb knowledge base index
/.pi/dashboard/kb/index.db
.reverse-spec-scratch/
# site/design-scratch/ is TRACKED: the mockup, its generator scripts and the
# screenshot playbook are the source the marketing site is designed from.
# Only the heavy machine-produced output is ignored -- renders and encoded
# video are reproducible from the scripts next to them, and one hero render
# alone is 121 MB.
site/design-scratch/**/out/
site/design-scratch/**/renders/
site/design-scratch/shots/out/
site/design-scratch/**/node_modules/
/package-lock.json

# ship-it escape-hatch handoff note — local working state, never a deliverable
SHIP_IT_BLOCKED.md

# mutation-harness crash-safety journal — transient per-worktree recovery state.
# A committed journal would itself be residue.
.mutation-journal/

# pytest cache (document-converter python work). Self-ignores via a nested
# .pytest_cache/.gitignore, which `kb dox lint` does not honour — so it showed
# up as a missing-row finding. Ignore it from the root instead.
.pytest_cache/

# `manage-flows` was deliberately retired (chore(skills): remove superseded
# manage-flows skill), but `pnpm install` still materializes a copy from the
# published pi-flows package into `.pi/skills/`. That untracked copy was then
# re-committed by a stray `git add -A` in #664, and its 463-char description
# breaks the 400-char repository budget in `check-skill-frontmatter.mjs` (which
# discovers via `git ls-files`, so only a TRACKED copy can fail CI). Ignored
# here rather than in `.git/info/exclude`, which is local-only and therefore
# hid the problem on the authoring machine while CI still saw it.
.pi/skills/manage-flows/
