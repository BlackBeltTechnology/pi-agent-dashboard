{
  "name": "@blackbelt-technology/pi-dashboard-context-budget",
  "version": "0.8.0",
  "description": "Per-turn context budget meter: captures the real provider payload via before_provider_request and attributes it to system-prompt blocks, skill catalogue entries and per-tool schemas. Proves a context trim actually reached the wire.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/context-budget"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-window",
    "observability"
  ],
  "pi": {
    "extensions": [
      "src/meter.ts"
    ]
  },
  "bin": {
    "context-budget": "./bin/context-budget.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/",
    "src/",
    "bin/",
    "!src/__tests__",
    "README.md",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10"
  }
}
