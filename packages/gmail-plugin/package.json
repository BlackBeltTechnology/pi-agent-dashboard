{
  "name": "@blackbelt-technology/pi-dashboard-gmail-plugin",
  "version": "0.9.0",
  "description": "Multi-account Gmail for pi agents — guided Google OAuth setup, per-account permission levels, server-side token leasing and account-scoped Gmail tools with confirmed writes.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/gmail-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge/index.ts",
      "default": "./src/bridge/index.ts"
    }
  },
  "files": [
    "src/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "pi-dashboard-plugin": {
    "id": "gmail",
    "displayName": "Gmail",
    "i18nCatalog": "catalog",
    "priority": 210,
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "bridge": "./src/bridge/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": [
      {
        "slot": "settings-section",
        "component": "GmailSettings",
        "tab": "general"
      }
    ]
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.9.0",
    "oauth4webapi": "^3.8.8",
    "@fastify/rate-limit": "^11.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
