{
  "name": "@blackbelt-technology/pi-dashboard-video-transcription",
  "version": "0.8.0",
  "description": "Full TypeScript port of the video-transcription pi skill. Transcribes local video/audio to speaker-diarized SRT via the Soniox async API (default) or AssemblyAI (opt-in, EU endpoint), with long-recording chunking and idempotent re-runs. ffmpeg/ffprobe are external prerequisites.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/video-transcription"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-skill",
    "video-transcription",
    "transcription",
    "srt",
    "subtitles",
    "soniox",
    "assemblyai",
    "ffmpeg",
    "speaker-diarization"
  ],
  "pi": {
    "skills": [
      ".pi/skills/video-transcription"
    ],
    "tools": [
      {
        "id": "ffmpeg",
        "probe": "resolve",
        "optional": true
      },
      {
        "id": "ffprobe",
        "probe": "resolve",
        "optional": true
      },
      {
        "id": "SONIOX_API_KEY",
        "probe": "env"
      },
      {
        "id": "ASSEMBLY_AI_KEY",
        "probe": "env",
        "optional": true
      }
    ]
  },
  "bin": {
    "pi-transcribe": "src/bin/transcribe.ts"
  },
  "files": [
    "src/",
    "!src/__tests__",
    ".pi/skills/",
    "README.md",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md"
  ],
  "scripts": {
    "test": "vitest run",
    "parity": "tsx parity/parity-check.ts",
    "parity:docker": "parity/run.sh"
  },
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "typebox": ">=1.3.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "typebox": ">=1.3.6",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "@ffprobe-installer/ffprobe": "^2.1.2"
  }
}
