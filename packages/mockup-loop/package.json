{
  "name": "@blackbelt-technology/frontend-mockup-loop",
  "version": "0.11.0",
  "description": "Pi extension + skill for a ground→contract→mockup→test→fix→learn frontend design loop. Ships a live mockup server tool, a Playwright breakpoint-screenshot tool, and a design-contract scaffolder. Works in any React/Tailwind/shadcn project.",
  "type": "module",
  "bin": {
    "mock-decide": "src/mock-site/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/mockup-loop"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "frontend",
    "mockup",
    "wireframe",
    "design-system",
    "ux",
    "accessibility",
    "ui"
  ],
  "pi": {
    "extensions": [
      "src/extension.ts"
    ],
    "skills": [
      ".pi/skills/frontend-mockup-loop"
    ],
    "tools": [
      {
        "id": "chromium",
        "probe": "pw-browser",
        "optional": true
      }
    ]
  },
  "files": [
    "src/",
    "site/",
    "!src/__tests__",
    "presets-data/",
    ".pi/skills/",
    "references/",
    "README.md",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md"
  ],
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "eslint-plugin-tailwindcss": "^3.17.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "typebox": ">=1.3.6",
    "vite": ">=5.4.21 <6.0.0 || >=6.4.1 <6.4.4 || >=6.4.5 <7.0.0 || >=7.0.8 <7.1.0 || >=7.1.11",
    "@vitejs/plugin-react": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "typebox": ">=1.3.6"
  }
}
