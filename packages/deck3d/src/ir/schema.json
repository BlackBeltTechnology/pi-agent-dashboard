{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackbelt.technology/pi-dashboard/deck3d/schema.json",
  "title": "Deck IR",
  "description": "Deck IR (deck.json) — the documented intermediate representation between a markdown slide source and the rendered 3D deck. `defaults` and `slides[]` are DERIVED by `parse` (regenerated every parse). `overrides` is the ONLY region a human or LLM may write; it survives re-parse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "defaults", "slides", "overrides"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "Provenance and integrity metadata. Written by parse; not a tuning surface.",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Path to the markdown source this IR was derived from. Relative to the deck.json location when possible."
        },
        "engine": {
          "type": "string",
          "description": "deck3d engine version that produced the derived fields."
        },
        "mermaid": {
          "type": "string",
          "description": "Exact pinned mermaid version used for harvesting diagram layout."
        },
        "derivedHash": {
          "type": "string",
          "description": "sha256 over the canonical derived fields (defaults + slides). `validate` recomputes it to detect edits made outside `overrides`."
        }
      }
    },

    "defaults": {
      "$ref": "#/definitions/defaults"
    },

    "slides": {
      "type": "array",
      "description": "Derived per-slide content, in presentation order. Regenerated by parse; edit `overrides.slides` instead.",
      "items": { "$ref": "#/definitions/slide" }
    },

    "overrides": {
      "$ref": "#/definitions/overrides"
    }
  },

  "definitions": {
    "defaults": {
      "type": "object",
      "description": "Deck-level visual defaults applied to every slide unless a slide overrides them.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dark", "light"],
          "default": "dark",
          "description": "Dark or light palette variant. Switches background, card and text colours together."
        },
        "palette": {
          "type": "string",
          "enum": ["blackbelt", "zenit", "dapp", "custom"],
          "default": "blackbelt",
          "description": "Named colour palette. `custom` reads `colors` below."
        },
        "colors": {
          "type": "object",
          "description": "Colour overrides used when palette is `custom` (CSS hex).",
          "additionalProperties": false,
          "properties": {
            "card": { "type": "string", "description": "Card/surface colour for the custom palette." },
            "accent": { "type": "string", "description": "Accent (primary highlight) colour." },
            "secondary": { "type": "string", "description": "Secondary colour for edges and secondary meshes." }
          }
        },
        "material": {
          "type": "string",
          "enum": ["glass", "metal", "matte"],
          "default": "glass",
          "description": "PBR material family for node cards and diagram primitives."
        },
        "envReflections": {
          "type": "boolean",
          "default": true,
          "description": "Enable environment-map reflections on metallic/glass materials."
        },
        "mirrorFloor": {
          "type": "boolean",
          "default": true,
          "description": "Show the reflective floor plane."
        },
        "softShadows": {
          "type": "boolean",
          "default": true,
          "description": "Enable soft (PCF) shadows under objects."
        },
        "bloom": {
          "type": "boolean",
          "default": true,
          "description": "Enable the bloom post pass (titles glow). Disabled at `quality: low`."
        },
        "rimLight": {
          "type": "boolean",
          "default": true,
          "description": "Enable the rim light that outlines silhouettes."
        },
        "fog": {
          "type": "boolean",
          "default": true,
          "description": "Enable depth fog so distant slides fade into the background."
        },
        "backgroundIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "Opacity of the animated background scene (0 = hidden, 1 = full)."
        },
        "transition": {
          "type": "string",
          "default": "dolly",
          "description": "Transition effect id (from the `transition` kind of the fx corpus) played on slide change."
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.4,
          "description": "Transition duration in seconds."
        },
        "depthRelief": {
          "type": "number",
          "minimum": 0,
          "default": 0.7,
          "description": "Depth offset (world units) applied per diagram rank so a 2D layout reads as a 3D staircase. Higher = more relief."
        },
        "quality": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "high",
          "description": "Quality tier: scales bloom, reflections, shadow resolution and particle count, and sets the effect cost budget (low 6 / medium 12 / high 20)."
        },
        "extrudeDepth": {
          "type": "number",
          "minimum": 0,
          "default": 0.18,
          "description": "Extrusion depth of 3D title glyphs."
        },
        "camera": {
          "type": "object",
          "description": "Default camera framing.",
          "additionalProperties": false,
          "properties": {
            "distance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 7,
              "description": "Distance from the slide's focal plane. Larger = more content in frame but smaller labels."
            }
          }
        },
        "labels": {
          "type": "object",
          "description": "Default diagram-label treatment.",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 0.28,
              "description": "World-space cap height of diagram label planes. Projected cap height must stay \u2265 14 px at 1920\u00d71080."
            }
          }
        },
        "check": {
          "$ref": "#/definitions/check"
        }
      }
    },

    "check": {
      "type": "object",
      "description": "Per-slide check configuration.",
      "additionalProperties": false,
      "properties": {
        "ignore": {
          "type": "array",
          "description": "Object ids the fit/legibility check should skip (reported as `skipped`, never silently).",
          "items": { "type": "string" }
        }
      }
    },

    "slide": {
      "type": "object",
      "description": "A single derived slide. Regenerated by parse.",
      "additionalProperties": false,
      "required": ["index", "id", "title", "bullets", "scene", "diagram"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based position used by the `#<n>` deep link."
        },
        "id": {
          "type": "string",
          "pattern": "^(?!deck3d-)[a-z0-9-]+$",
          "description": "Stable slide id: ASCII-folded title slug, `-<ordinal>` on collision, or the `{#id}` pin from the heading. Never starts with `deck3d-` (reserved for generated slides)."
        },
        "kind": {
          "type": "string",
          "enum": ["title", "content", "section", "credits"],
          "default": "content",
          "description": "Slide role. Governs title treatment and layout; `credits` is appended by render, never authored."
        },
        "title": {
          "type": "string",
          "description": "Slide title, rendered as extruded 3D text."
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle paragraph shown under the title."
        },
        "bullets": {
          "type": "array",
          "description": "Bullet lines shown in the side panel.",
          "items": { "type": "string" }
        },
        "scene": {
          "type": "string",
          "description": "Background scene id (e.g. `tokens`, `rings`, `swarm`, `aurora`, `none`)."
        },
        "diagram": {
          "$ref": "#/definitions/diagram"
        },
        "camera": {
          "$ref": "#/definitions/camera"
        },
        "labels": {
          "$ref": "#/definitions/labels"
        },
        "check": {
          "$ref": "#/definitions/check"
        },
        "effects": {
          "type": "array",
          "description": "Derived default effect list for this slide (replaced wholesale by `overrides.slides[id].effects`).",
          "items": { "$ref": "#/definitions/effectRef" }
        }
      }
    },

    "camera": {
      "type": "object",
      "description": "Camera framing for this slide.",
      "additionalProperties": false,
      "properties": {
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Distance from the focal plane. Larger pulls back and shrinks labels."
        }
      }
    },

    "labels": {
      "type": "object",
      "description": "Diagram-label treatment for this slide.",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "World-space cap height of diagram label planes."
        }
      }
    },

    "diagram": {
      "type": "object",
      "description": "Derived diagram geometry. `kind: none` means no diagram (unsupported or absent).",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["none", "flowchart", "sequence", "brain", "loop", "swarm"],
          "description": "Diagram builder to use. `none` = no diagram."
        },
        "dir": {
          "type": "string",
          "enum": ["TD", "TB", "BT", "LR", "RL"],
          "description": "Flowchart rank direction as declared in the source."
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1,
          "description": "Overall diagram scale in world units (override: `overrides.slides[id].diagram.scale`)."
        },
        "offset": {
          "type": "object",
          "description": "Diagram translation in world units (override: `overrides.slides[id].diagram.offset`).",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "description": "Horizontal offset (+ right)." },
            "y": { "type": "number", "description": "Vertical offset (+ up)." }
          }
        },
        "nodes": {
          "type": "array",
          "description": "Flowchart nodes with engine layout.",
          "items": { "$ref": "#/definitions/node" }
        },
        "edges": {
          "type": "array",
          "description": "Flowchart edges with sampled path geometry.",
          "items": { "$ref": "#/definitions/edge" }
        },
        "groups": {
          "type": "array",
          "description": "Flowchart subgraphs.",
          "items": { "$ref": "#/definitions/group" }
        },
        "actors": {
          "type": "array",
          "description": "Sequence-diagram actors in declaration order.",
          "items": { "$ref": "#/definitions/actor" }
        },
        "messages": {
          "type": "array",
          "description": "Sequence-diagram messages in source order.",
          "items": { "$ref": "#/definitions/message" }
        }
      }
    },

    "node": {
      "type": "object",
      "description": "A flowchart node.",
      "additionalProperties": false,
      "required": ["id", "label", "shape", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string", "description": "Mermaid node id (author-chosen, stable)." },
        "label": { "type": "string", "description": "Displayed label text." },
        "shape": {
          "type": "string",
          "enum": ["rect", "stadium", "round", "hexagon", "circle", "doublecircle", "diamond", "cylinder"],
          "description": "3D primitive to build for this node."
        },
        "x": { "type": "number", "description": "X position from the engine layout (layout units)." },
        "y": { "type": "number", "description": "Y position from the engine layout (layout units)." },
        "w": { "type": "number", "description": "Node width from the engine layout." },
        "h": { "type": "number", "description": "Node height from the engine layout." },
        "group": { "type": "string", "description": "Subgraph title this node belongs to, when any." }
      }
    },

    "edge": {
      "type": "object",
      "description": "A flowchart edge.",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "path"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable edge id `<from>-><to>#<k>` (k = ordinal among parallel edges in source order)."
        },
        "from": { "type": "string", "description": "Source node id (must exist in `nodes`)." },
        "to": { "type": "string", "description": "Target node id (must exist in `nodes`)." },
        "kind": {
          "type": "string",
          "enum": ["normal", "dotted", "thick"],
          "description": "Edge stroke kind: solid arrow, dotted, or thick labelled."
        },
        "label": { "type": "string", "description": "Edge label text, when present." },
        "path": {
          "type": "array",
          "description": "Sampled points along the rendered edge curve, as [x, y] pairs.",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        }
      }
    },

    "group": {
      "type": "object",
      "description": "A flowchart subgraph.",
      "additionalProperties": false,
      "required": ["id", "title", "nodes"],
      "properties": {
        "id": { "type": "string", "description": "Subgraph id from the source." },
        "title": { "type": "string", "description": "Subgraph title." },
        "nodes": {
          "type": "array",
          "description": "Member node ids.",
          "items": { "type": "string" }
        }
      }
    },

    "actor": {
      "type": "object",
      "description": "A sequence-diagram actor.",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "description": "Actor name from the source (stable)." },
        "label": { "type": "string", "description": "Display label (description or name)." }
      }
    },

    "message": {
      "type": "object",
      "description": "A sequence-diagram message.",
      "additionalProperties": false,
      "required": ["id", "from", "to", "text", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^m\\d+$", "description": "Stable message id `m<index>` in source order." },
        "from": { "type": "string", "description": "Sender actor id." },
        "to": { "type": "string", "description": "Receiver actor id (equal to `from` for self-messages)." },
        "text": { "type": "string", "description": "Message label text." },
        "kind": {
          "type": "string",
          "enum": ["solid", "dotted"],
          "description": "Solid request/response vs dotted reply."
        }
      }
    },

    "effectRef": {
      "type": "object",
      "description": "Reference to an effect in the fx corpus, with optional parameter values.",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "Effect id from `fx list` (e.g. `bloom`, `starfield`)." },
        "params": {
          "type": "object",
          "description": "Effect parameters; each is bounded by the effect's card schema and validated by `validate`.",
          "additionalProperties": true
        }
      }
    },

    "prop": {
      "type": "object",
      "description": "A glTF model placed on a slide. Selection is the LLM's job; code fetches, hash-pins and renders it.",
      "additionalProperties": false,
      "required": ["source", "id", "licence", "author", "sha256", "slide", "role"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["vendored", "poly-pizza", "generated"],
          "description": "Where the model came from."
        },
        "id": { "type": "string", "description": "Source-specific model id." },
        "licence": {
          "type": "string",
          "description": "SPDX licence id (e.g. `CC0-1.0`, `CC-BY-4.0`, or `generated`)."
        },
        "author": { "type": "string", "description": "Attribution string for the credits slide." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the cached normalised GLB. `render` refuses a mismatch." },
        "slide": { "type": "string", "description": "Target slide id." },
        "role": {
          "type": "string",
          "pattern": "^(hero|illustration|ambient|node:.+)$",
          "description": "Placement: `hero`, `illustration`, `ambient` (background instances), or `node:<nodeId>` (replaces a diagram node)."
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Target world-space bounding-box size (longest axis)."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Instance count for the `ambient` role."
        },
        "restyle": {
          "type": "string",
          "enum": ["palette", "original"],
          "description": "`palette` swaps materials for the deck PBR palette; `original` keeps the source materials."
        },
        "anim": {
          "type": "string",
          "enum": ["none", "float", "orbit", "spin"],
          "description": "Animation preset applied to the prop group."
        }
      }
    },

    "overrides": {
      "type": "object",
      "description": "The ONLY user-writable region. Objects deep-merge over derived values; arrays replace.",
      "additionalProperties": false,
      "properties": {
        "deck": {
          "$ref": "#/definitions/defaults"
        },
        "effects": {
          "type": "array",
          "description": "Deck-level effect list (replaces the deck default list).",
          "items": { "$ref": "#/definitions/effectRef" }
        },
        "props": {
          "type": "array",
          "description": "Models placed on slides.",
          "items": { "$ref": "#/definitions/prop" }
        },
        "slides": {
          "type": "object",
          "description": "Per-slide overrides keyed by slide id.",
          "propertyNames": { "pattern": "^[a-z0-9-]+$" },
          "additionalProperties": {
            "type": "object",
            "description": "Partial per-slide override; every field deep-merges over the derived slide.",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["dark", "light"], "description": "Override the slide's palette mode." },
              "palette": { "type": "string", "enum": ["blackbelt", "zenit", "dapp", "custom"], "description": "Override the slide's palette." },
              "material": { "type": "string", "enum": ["glass", "metal", "matte"], "description": "Override the slide's material family." },
              "transition": { "type": "string", "description": "Override the transition effect id for entering this slide." },
              "quality": { "type": "string", "enum": ["low", "medium", "high"], "description": "Override the quality tier for this slide." },
              "scene": { "type": "string", "description": "Override the background scene id." },
              "backgroundIntensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Override the background scene opacity." },
              "diagram": {
                "type": "object",
                "description": "Diagram framing overrides.",
                "additionalProperties": false,
                "properties": {
                  "scale": { "type": "number", "exclusiveMinimum": 0, "description": "Scale the diagram up/down to fit." },
                  "offset": {
                    "type": "object",
                    "description": "Translate the diagram.",
                    "additionalProperties": false,
                    "properties": {
                      "x": { "type": "number", "description": "Horizontal offset." },
                      "y": { "type": "number", "description": "Vertical offset." }
                    }
                  }
                }
              },
              "camera": {
                "type": "object",
                "description": "Camera framing override.",
                "additionalProperties": false,
                "properties": {
                  "distance": { "type": "number", "exclusiveMinimum": 0, "description": "Pull the camera closer/further to fix fit or label size." }
                }
              },
              "labels": {
                "type": "object",
                "description": "Label treatment override.",
                "additionalProperties": false,
                "properties": {
                  "size": { "type": "number", "exclusiveMinimum": 0, "description": "Grow labels to fix legibility." }
                }
              },
              "check": {
                "$ref": "#/definitions/check"
              },
              "effects": {
                "type": "array",
                "description": "Replaces the slide's derived default effect list.",
                "items": { "$ref": "#/definitions/effectRef" }
              }
            }
          }
        },
        "nodes": {
          "type": "object",
          "description": "Per-node overrides keyed by `<slideId>/<nodeId>`.",
          "propertyNames": { "pattern": "^[^/]+/[^/]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "shape": { "type": "string", "enum": ["rect", "stadium", "round", "hexagon", "circle", "doublecircle", "diamond", "cylinder"], "description": "Change the node's 3D primitive." },
              "label": { "type": "string", "description": "Reword the node's label." },
              "position": {
                "type": "object",
                "description": "Nudge the node in world units.",
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number", "description": "Horizontal nudge." },
                  "y": { "type": "number", "description": "Vertical nudge." },
                  "z": { "type": "number", "description": "Depth nudge." }
                }
              },
              "size": {
                "type": "object",
                "description": "Override the node's box size.",
                "additionalProperties": false,
                "properties": {
                  "w": { "type": "number", "exclusiveMinimum": 0, "description": "Width." },
                  "h": { "type": "number", "exclusiveMinimum": 0, "description": "Height." }
                }
              },
              "material": { "type": "string", "enum": ["glass", "metal", "matte"], "description": "Override the node's material family." }
            }
          }
        },
        "edges": {
          "type": "object",
          "description": "Per-edge overrides keyed by `<slideId>/<edgeId>`.",
          "propertyNames": { "pattern": "^[^/]+/.+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["normal", "dotted", "thick"], "description": "Change the edge stroke kind." },
              "material": { "type": "string", "enum": ["glass", "metal", "matte"], "description": "Override the edge material family." }
            }
          }
        }
      }
    }
  }
}
