{
  "name": "@blackbelt-technology/pi-dashboard-mcp-client-plugin",
  "version": "0.9.0",
  "description": "First-party dashboard plugin managing pi's built-in MCP configuration: Pi-global + trusted-folder mcp.json view with live state from `pi mcp list`, validated atomic writes, and global + folder MCP management surfaces.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/mcp-client-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    }
  },
  "files": [
    "src/",
    "schema/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "wouter": ">=3.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.9.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.0.0",
    "wouter": "^3.9.0"
  },
  "pi-dashboard-plugin": {
    "id": "mcp-client",
    "displayName": "MCP Client",
    "priority": 100,
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "claims": [
      {
        "slot": "settings-section",
        "component": "McpSettingsClaim",
        "tab": "general"
      },
      {
        "slot": "sidebar-folder-section",
        "component": "FolderMcpSection"
      },
      {
        "slot": "worktree-card-section",
        "component": "FolderMcpSection"
      },
      {
        "slot": "shell-overlay-route",
        "component": "FolderMcpPage",
        "path": "/folder/:encodedCwd/mcp",
        "depth": 2,
        "parentPath": "/folder/:encodedCwd"
      }
    ]
  }
}
