{
  "name": "@blackbelt-technology/pi-dashboard-agent-teams-plugin",
  "version": "0.11.0",
  "description": "Agent teams core for pi-dashboard \u2014 a lead session spawns visible teammate sessions and coordinates them through a shared task list and mailbox.",
  "keywords": [
    "pi-dashboard-plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/agent-teams-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge/index.ts",
      "default": "./src/bridge/index.ts"
    }
  },
  "files": [
    "src/",
    "prompts/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "pi-dashboard-plugin": {
    "id": "agent-teams",
    "displayName": "Agent Teams",
    "i18nCatalog": "catalog",
    "priority": 100,
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "bridge": "./src/bridge/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": [
      {
        "slot": "session-card-badge",
        "component": "TeamBadge",
        "predicate": "isTeamSession"
      },
      {
        "slot": "shell-overlay-route",
        "component": "TeamViewClaim",
        "module": "./src/client/TeamView.tsx",
        "path": "/session/:sessionId/team",
        "sessionParam": "sessionId",
        "depth": 2,
        "parentPath": "/session/:sessionId",
        "presentation": "content"
      },
      {
        "slot": "custom-entry-renderer",
        "customType": "agent-teams-mail",
        "component": "MailEntryCard",
        "module": "./src/client/MailEntryCard.tsx"
      },
      {
        "slot": "custom-entry-renderer",
        "customType": "agent-teams-idle",
        "component": "MailEntryCard",
        "module": "./src/client/MailEntryCard.tsx"
      },
      {
        "slot": "custom-entry-renderer",
        "customType": "agent-teams-notice",
        "component": "MailEntryCard",
        "module": "./src/client/MailEntryCard.tsx"
      },
      {
        "slot": "custom-entry-renderer",
        "customType": "agent-teams-approval",
        "component": "ApprovalCard",
        "module": "./src/client/ApprovalCard.tsx"
      },
      {
        "slot": "custom-entry-renderer",
        "customType": "agent-teams-playbook",
        "component": "PlaybookCard",
        "module": "./src/client/PlaybookCard.tsx"
      },
      {
        "slot": "sidebar-folder-section",
        "component": "StartTeamFolderAction",
        "module": "./src/client/StartTeamFolderAction.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TeamCreate",
        "component": "TeamLifecycleToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TeammateSpawn",
        "component": "TeamLifecycleToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TeamStatus",
        "component": "TeamLifecycleToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TeamDelete",
        "component": "TeamLifecycleToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "SendMessage",
        "component": "TeamMessageToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TaskCreate",
        "component": "TeamTaskToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TaskList",
        "component": "TeamTaskToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TaskGet",
        "component": "TeamTaskToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "TaskUpdate",
        "component": "TeamTaskToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "ShutdownRequest",
        "component": "TeamShutdownToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      },
      {
        "slot": "tool-renderer",
        "toolName": "ShutdownResponse",
        "component": "TeamShutdownToolRenderer",
        "module": "./src/client/TeamToolRenderers.tsx"
      }
    ],
    "emits": [
      "agent-teams:mail",
      "agent-teams:team_closed",
      "agent-teams:changed",
      "agent-teams:inproc"
    ]
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "wouter": ">=3.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.11.0",
    "@blackbelt-technology/pi-dashboard-client-utils": "^0.11.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.11.0",
    "@fastify/rate-limit": "^11.2.0",
    "@mdi/js": "^7.4.47",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wouter": "^3.9.0"
  }
}
