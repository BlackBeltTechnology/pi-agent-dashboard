{
  "name": "@blackbelt-technology/pi-dashboard-cost-estimator",
  "version": "0.7.0",
  "description": "Software cost & effort estimation from use cases, functional and non-functional requirements and a tech stack. Sizes with Use Case Points + COCOMO II scale, routes NFRs to derived scope or a residual multiplier, distributes effort across 11 roles, compares four delivery modes (human_only, human_with_ai, ai_steered_human_supervised, agentic_hitl), and runs a Beta-PERT Monte Carlo plus an NPV/ROI business case. Calibrates agent cost and steering time from real pi session telemetry.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/cost-estimator"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-skill",
    "pi-dashboard",
    "cost-estimation",
    "effort-estimation",
    "use-case-points",
    "cocomo",
    "monte-carlo",
    "business-case",
    "agentic-cost",
    "session-telemetry"
  ],
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./engine/*.js": "./src/engine/*.ts",
    "./engine/*": "./src/engine/*",
    "./telemetry/*.js": "./src/telemetry/*.ts",
    "./telemetry/*": "./src/telemetry/*",
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "bin": {
    "pi-estimate": "bin/estimate.mjs",
    "pi-estimate-calibrate": "bin/calibrate.mjs",
    "pi-estimate-calibrate-sessions": "bin/calibrate-sessions.mjs"
  },
  "pi": {
    "skills": [
      ".pi/skills/software-cost-estimator"
    ]
  },
  "pi-dashboard-plugin": {
    "id": "cost-estimator",
    "displayName": "Cost",
    "priority": 100,
    "requiredApi": "^0.x",
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": [
      {
        "slot": "content-view",
        "component": "CostView"
      },
      {
        "slot": "command-route",
        "component": "CostView",
        "command": "cost"
      },
      {
        "slot": "settings-section",
        "component": "CostSettings",
        "config": {
          "tab": "general"
        }
      }
    ]
  },
  "files": [
    "src/",
    "bin/",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    ".pi/skills/",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.7.0",
    "@blackbelt-technology/pi-dashboard-session-distiller": "^0.7.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.7.0"
  }
}
