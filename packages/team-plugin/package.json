{
  "name": "@blackbelt-technology/pi-dashboard-team-plugin",
  "version": "0.8.0",
  "description": "Dashboard plugin: persistent per-user AI team agents (personas, project teams, conversations) with an isolation guard, served as an app at /apps/team/.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/team-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./extension": {
      "types": "./src/extension/index.ts",
      "default": "./src/extension/index.ts"
    }
  },
  "files": [
    "src/",
    "dist/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "pi-dashboard-plugin": {
    "id": "team",
    "displayName": "AI Team",
    "priority": 100,
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": [
      {
        "slot": "sidebar-folder-section",
        "component": "FolderTeamSection"
      }
    ],
    "i18nCatalog": "catalog"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.8.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0",
    "@fastify/rate-limit": "^11.2.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@blackbelt-technology/pi-dashboard-client-utils": "^0.8.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "wouter": ">=3.0.0"
  },
  "devDependencies": {
    "fastify": "^5.0.0",
    "typescript": "^5.9.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1"
  }
}
