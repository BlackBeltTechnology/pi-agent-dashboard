{
  "name": "@blackbelt-technology/pi-dashboard-nano-banana",
  "version": "0.9.0",
  "description": "TypeScript port of the nano-banana-imagegen pi skill. Generate and edit images with Google Gemini image models via the @the-focus-ai/nano-banana CLI, with GEMINI_API_KEY resolution, output-path handling and batch generation. Exposed as a pi skill and the pi-nano-banana CLI bin.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/nano-banana"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-skill",
    "nano-banana",
    "image-generation",
    "gemini",
    "text-to-image",
    "image-editing"
  ],
  "pi": {
    "skills": [
      ".pi/skills/nano-banana-imagegen"
    ],
    "tools": [
      {
        "id": "GEMINI_API_KEY",
        "probe": "env"
      }
    ]
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "bin": {
    "pi-nano-banana": "bin/pi-nano-banana"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "!src/__tests__",
    ".pi/skills/",
    "README.md",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md"
  ],
  "scripts": {
    "test": "vitest run",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-shared": "^0.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "typebox": ">=1.3.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typebox": ">=1.3.6",
    "vitest": "^2.1.8"
  }
}
