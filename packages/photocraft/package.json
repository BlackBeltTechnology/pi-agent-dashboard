{
  "name": "@blackbelt-technology/pi-dashboard-photocraft",
  "version": "0.9.0",
  "description": "Headless PhotoCraft image editing for pi agents: provisions the photocraft-cli binary on demand, exposes it over bash and a project-confined stdio MCP server, and adds replace-region — pixel-exact generative part-replacement combined with pi-nano-banana. Exposed as a pi skill and the pi-photocraft CLI bin.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/photocraft"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-skill",
    "photocraft",
    "image-editing",
    "mcp",
    "photoshop"
  ],
  "pi": {
    "skills": [
      ".pi/skills/photocraft"
    ]
  },
  "exports": {
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "bin": {
    "pi-photocraft": "bin/pi-photocraft"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "!src/__tests__",
    ".pi/skills/",
    "README.md",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md"
  ],
  "scripts": {
    "test": "vitest run",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-nano-banana": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "vitest": "^2.1.8"
  }
}
