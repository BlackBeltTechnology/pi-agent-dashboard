<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ok" isExecutable="false">
    <bpmn:startEvent id="Start_ok"><bpmn:outgoing>Flow_o1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="Activity_expanded" name="Expanded">
      <bpmn:incoming>Flow_o1</bpmn:incoming><bpmn:outgoing>Flow_o2</bpmn:outgoing>
      <bpmn:startEvent id="Start_inner_ok"><bpmn:outgoing>Flow_in</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Activity_inner" name="Inner"><bpmn:incoming>Flow_in</bpmn:incoming></bpmn:task>
      <bpmn:sequenceFlow id="Flow_in" sourceRef="Start_inner_ok" targetRef="Activity_inner"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="End_ok"><bpmn:incoming>Flow_o2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_o1" sourceRef="Start_ok" targetRef="Activity_expanded"/>
    <bpmn:sequenceFlow id="Flow_o2" sourceRef="Activity_expanded" targetRef="End_ok"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_ok">
    <bpmndi:BPMNShape id="Start_ok_di" bpmnElement="Start_ok"><dc:Bounds x="100" y="200" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Activity_expanded_di" bpmnElement="Activity_expanded" isExpanded="true"><dc:Bounds x="200" y="120" width="300" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_inner_ok_di" bpmnElement="Start_inner_ok"><dc:Bounds x="240" y="200" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Activity_inner_di" bpmnElement="Activity_inner"><dc:Bounds x="320" y="180" width="100" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_ok_di" bpmnElement="End_ok"><dc:Bounds x="560" y="200" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_o1_di" bpmnElement="Flow_o1"><di:waypoint x="136" y="218"/><di:waypoint x="200" y="220"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_o2_di" bpmnElement="Flow_o2"><di:waypoint x="500" y="220"/><di:waypoint x="560" y="218"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_in_di" bpmnElement="Flow_in"><di:waypoint x="276" y="218"/><di:waypoint x="320" y="220"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
