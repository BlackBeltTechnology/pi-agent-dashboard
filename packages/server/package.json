{
  "name": "@blackbelt-technology/pi-dashboard-server",
  "version": "0.9.0",
  "description": "Dashboard server for monitoring and interacting with pi agent sessions",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "piCompatibility": {
    "minimum": "1.0.0",
    "recommended": "1.0.0",
    "maximum": null
  },
  "piDashboard": {
    "minShellVersion": "0.8.0",
    "bundledPlugins": [
      "roles-plugin",
      "flows-plugin",
      "flows-anthropic-bridge-plugin",
      "automation-plugin",
      "goal-plugin",
      "subagents-plugin",
      "kb-plugin",
      "hermes-memory-plugin",
      "context-mode-settings-plugin",
      "grammar-plugin",
      "blackhole-plugin",
      "gmail-plugin",
      "mcp-server-plugin",
      "apple-tools",
      "mcp-client-plugin",
      "cost-estimator",
      "quota-plugin",
      "browser-plugin",
      "keycloak-resolver-plugin",
      "chat-gateway",
      "system-one-plugin",
      "team-plugin"
    ]
  },
  "main": "src/cli.ts",
  "bin": {
    "pi-dashboard": "bin/pi-dashboard.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "runtime-lock.json",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-pty-permissions.cjs"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-document-converter": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-extension": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-mcp-client-plugin": "^0.9.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.9.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/http-proxy": "^11.4.3",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/reply-from": "^12.6.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.0",
    "@fission-ai/openspec": "1.11.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "asciidoctor": "^3.0.4",
    "bonjour-service": "^1.3.0",
    "chardet": "^2.1.0",
    "diff": "^8.0.3",
    "fastify": "^5.0.0",
    "iconv-lite": "^0.6.3",
    "isomorphic-dompurify": "3.18.0",
    "jimp": "^1.6.1",
    "jiti": "^2.7.0",
    "jose": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "3.9.14",
    "mammoth": "^1.12.0",
    "node-pty": "1.2.0-beta.13",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "semver": "^7.7.1",
    "tsx": "^4.21.0",
    "undici": "^7.29.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@blackbelt-technology/pi-dashboard-mcp-server-plugin": "^0.9.0",
    "@types/diff": "^7.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  }
}
