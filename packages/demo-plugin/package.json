{
  "name": "@blackbelt-technology/demo-plugin",
  "version": "0.9.0",
  "private": true,
  "description": "Demo plugin — runtime fixture only. SHALL NOT ship in production builds.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/client.tsx",
      "default": "./src/client.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge/index.ts",
      "default": "./src/bridge/index.ts"
    }
  },
  "pi-dashboard-plugin": {
    "id": "demo",
    "displayName": "Demo Plugin (fixture)",
    "priority": 1000,
    "fixture": true,
    "client": "./src/client.tsx",
    "server": "./src/server/index.ts",
    "bridge": "./src/bridge/index.ts",
    "claims": [
      {
        "slot": "settings-section",
        "component": "DemoSettings",
        "tab": "general"
      },
      {
        "slot": "tool-renderer",
        "component": "DemoToolRenderer",
        "toolName": "DashboardDemo"
      }
    ]
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.9.0"
  },
  "devDependencies": {
    "react": "^19.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
