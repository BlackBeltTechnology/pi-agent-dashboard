      <interactionFlowModelElements xmi:type="ifml:Window" xmi:id="W.SCR-order" uml:name="Orders" isLandmark="true">
        <viewElementEvents xmi:type="ifml:ViewElementEvent" xmi:id="E.SCR-order.ACT-gone" uml:name="Gone &#34;quoted&#34; &#38; &#60;tagged&#62;" />
