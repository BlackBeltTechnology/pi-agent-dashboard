          <viewElementEvents xmi:type="ifml:OnSubmitEvent" xmi:id="E.SCR-order.ACT-add" uml:name="Add">
            <activationExpression xmi:type="ifml:ActivationExpression" xmi:id="X.SCR-order.ACT-add">
              <language>rebuild-package-ref</language>
              <body>BR-001</body>
            </activationExpression>
          </viewElementEvents>
          <viewComponentParts xmi:type="ifml:SimpleField" xmi:id="P.SCR-order.FRM-line.qty" uml:name="qty">
            <constraints xmi:type="ifml:ValidationRule" xmi:id="VR.SCR-order.FRM-line.qty.0">
              <language>javascript</language>
              <body>qty&gt;0</body>
            </constraints>
          </viewComponentParts>
          <viewComponentParts xmi:type="ifml:SelectionField" xmi:id="P.SCR-order.FRM-line.item" uml:name="item" />
        </viewElements>
        <actions xmi:type="ifml:Action" xmi:id="A.SCR-order.ACT-add" uml:name="Add">
          <actionEvents xmi:type="ifml:ActionEvent" xmi:id="AE.SCR-order.ACT-add" uml:name="done" />
        </actions>
        <isModal>false</isModal>
      </interactionFlowModelElements>
      <interactionFlowModelElements xmi:type="ifml:Window" xmi:id="W.DLG-sure" uml:name="DLG-sure">
