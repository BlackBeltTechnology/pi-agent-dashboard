{
  "name": "@blackbelt-technology/pi-dashboard-blackhole-plugin",
  "version": "0.8.0",
  "description": "Dashboard surface for the pi-blackhole extension — settings (config file editor + fallback chains) and the per-session memory pipeline subcard/detail view.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/blackhole-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "files": [
    "src/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "pi-dashboard-plugin": {
    "id": "blackhole",
    "displayName": "Blackhole",
    "i18nCatalog": "catalog",
    "priority": 200,
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": [
      {
        "slot": "settings-section",
        "component": "BlackholeSettings",
        "tab": "general"
      },
      {
        "slot": "session-card-memory",
        "component": "MemorySubcard",
        "shouldRender": "shouldRenderMemorySubcard"
      },
      {
        "slot": "content-view",
        "component": "PipelineDetailView",
        "predicate": "isPipelineDetailActive"
      }
    ],
    "requires": {
      "piExtensions": [
        "pi-blackhole"
      ]
    }
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "wouter": ">=3.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.8.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wouter": "^3.9.0"
  }
}
