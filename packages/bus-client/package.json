{
  "name": "@blackbelt-technology/pi-dashboard-bus-client",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/bus-client"
  },
  "description": "Headless, ticket-authenticated WebSocket bus client for the pi-dashboard control plane. Typed command send, correlated awaits, bus-consistent reads.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "files": [
    "src/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!src/codegen"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "codegen": "tsx src/codegen/generate-verbs.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
