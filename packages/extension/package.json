{
  "name": "@blackbelt-technology/pi-dashboard-extension",
  "version": "0.11.0",
  "description": "Pi bridge extension for pi-dashboard",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*.js": "./src/*.ts",
    "./*": "./src/*"
  },
  "pi": {
    "extensions": [
      "src/bridge.ts"
    ],
    "skills": [
      ".pi/skills/pi-dashboard",
      ".pi/skills/browser",
      ".pi/skills/project-init",
      ".pi/skills/project-access",
      ".pi/skills/doctor"
    ],
    "tools": [
      {
        "id": "agent-browser",
        "probe": "resolve"
      },
      {
        "id": "chromium",
        "probe": "pw-browser",
        "optional": true
      }
    ]
  },
  "files": [
    "src/",
    ".pi/skills/pi-dashboard/",
    ".pi/skills/browser/",
    ".pi/skills/project-init/",
    ".pi/skills/project-access/",
    ".pi/skills/doctor/",
    "agents/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-bus-client": "^0.11.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.11.0",
    "@fission-ai/openspec": "1.14.3",
    "minimatch": "^11.0.3",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0",
    "typebox": ">=1.3.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/ws": "^8.18.1",
    "typebox": "^1.3.27"
  }
}
