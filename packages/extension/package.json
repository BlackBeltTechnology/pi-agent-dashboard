{
  "name": "@blackbelt-technology/pi-dashboard-extension",
  "version": "0.8.0",
  "description": "Pi bridge extension for pi-dashboard",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "src/bridge.ts"
    ],
    "skills": [
      ".pi/skills/pi-dashboard",
      ".pi/skills/browser",
      ".pi/skills/project-init",
      ".pi/skills/doctor"
    ]
  },
  "files": [
    "src/",
    ".pi/skills/pi-dashboard/",
    ".pi/skills/browser/",
    ".pi/skills/project-init/",
    ".pi/skills/doctor/",
    "agents/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-bus-client": "^0.8.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0",
    "@fission-ai/openspec": "^1.6.0",
    "minimatch": "^10.0.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.75.5",
    "@earendil-works/pi-coding-agent": ">=0.80.10",
    "@earendil-works/pi-tui": ">=0.80.10",
    "@mariozechner/pi-coding-agent": ">=0.73.1",
    "@mariozechner/pi-tui": ">=0.73.1",
    "typebox": ">=1.3.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-tui": ">=0.80.10",
    "@types/ws": "^8.18.1",
    "typebox": "^1.3.7"
  }
}
