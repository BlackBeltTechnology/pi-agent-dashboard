{
  "name": "@blackbelt-technology/pi-dashboard-grammar-plugin",
  "version": "0.7.0",
  "description": "First-party dashboard plugin: fully self-contained composer grammar/spell-check \u2014 client composer UI (composer-panel), server route + backends (server entry), and settings (settings-section). See change: make-grammar-fully-plugin-contained.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/grammar-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./client": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "files": [
    "src/",
    "configSchema.json",
    "!**/__tests__",
    "!**/test-support",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.7.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.7.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "vitest": "^4.0.0"
  },
  "pi-dashboard-plugin": {
    "id": "grammar",
    "displayName": "Grammar & Spelling",
    "i18nCatalog": "catalog",
    "priority": 100,
    "client": "./src/index.tsx",
    "server": "./src/server/index.ts",
    "claims": [
      {
        "slot": "settings-section",
        "component": "GrammarSettings",
        "tab": "general"
      },
      {
        "slot": "composer-panel",
        "component": "GrammarComposerPanel"
      }
    ],
    "configSchema": "./configSchema.json"
  }
}
