{
  "name": "@blackbelt-technology/pi-dashboard-web-access-plugin",
  "version": "0.10.0",
  "description": "Dashboard rendering for the pi-web-access extension — compact, safe chat cards for web-search-results custom entries (search, fetch).",
  "keywords": [
    "pi-dashboard-plugin"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/web-access-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    }
  },
  "files": [
    "src/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "pi-dashboard-plugin": {
    "id": "web-access",
    "displayName": "Web access",
    "i18nCatalog": "catalog",
    "client": "./src/client/index.tsx",
    "claims": [
      {
        "slot": "custom-entry-renderer",
        "customType": "web-search-results",
        "component": "WebSearchEntryCard"
      }
    ],
    "requires": {
      "piExtensions": [
        "pi-web-access"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.10.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.10.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
