{
  "name": "pi-dashboard-ios-visual-tests",
  "private": true,
  "version": "1.0.0",
  "description": "iOS Appium/WebdriverIO visual regression tests for the pi-dashboard PWA",
  "type": "module",
  "scripts": {
    "test": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" wdio run ./wdio.conf.ts",
    "baseline": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" IOS_VISUAL_AUTO_SAVE_BASELINE=1 wdio run ./wdio.conf.ts",
    "test:fixture": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" node scripts/fixture-launcher.mjs",
    "baseline:fixture": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" IOS_VISUAL_AUTO_SAVE_BASELINE=1 node scripts/fixture-launcher.mjs",
    "doctor": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" appium driver doctor xcuitest",
    "driver:install": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" appium driver install xcuitest@10",
    "sim:create": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" bash scripts/sim-create.sh",
    "sim:udid": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" bash scripts/sim-udid.sh",
    "sim:reset": "APPIUM_HOME=\"${APPIUM_HOME:-$(pwd)/.tmp/appium-home}\" bash scripts/sim-reset.sh"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "@wdio/visual-service": "^6.0.0",
    "@types/mocha": "^10.0.0",
    "appium": "^3.0.0",
    "appium-xcuitest-driver": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "webdriverio": "^9.0.0",
    "ws": "^8.18.0"
  }
}
